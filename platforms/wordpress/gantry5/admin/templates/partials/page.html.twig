{% assets with { priority: 10 } %}
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ url('gantry-admin://assets/css-compiled/wordpress-g-admin.css') }}" type="text/css" />
    {% endblock %}

    {% block javascript %}
        <script>
            var GANTRY_AJAX_SUFFIX = {{ gantry.ajax_suffix|json_encode|raw }};
            var GANTRY_AJAX_URL = {{ gantry.route('%ajax%')|json_encode|raw }};
            var GANTRY_AJAX_CONF_URL = {{ gantry.route('configurations/%ajax%')|json_encode|raw }};
            var GANTRY_AJAX_NONCE = {{ gantry.ajax_nonce|json_encode|raw }};
            var GANTRY_PLATFORM = 'wordpress';
        </script>
    {% endblock %}
{% endassets -%}

<div id="g5-container">
    {% block content %}
    {% endblock %}

    {% block footer_section %}
    {% endblock %}
</div>

{% do gantry.platform.finalize() %}
